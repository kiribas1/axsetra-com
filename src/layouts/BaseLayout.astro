---
interface Props {
  title: string;
  description: string;
  lang: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const { title, description, lang, canonicalUrl, ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const canonical = canonicalUrl || `${siteUrl}${currentPath}`;
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const locales = ['en', 'es', 'zh', 'ru', 'pt', 'ar'];
const langNames: Record<string, string> = {
  en: 'English',
  es: 'Espanol',
  zh: '中文',
  ru: 'Русский',
  pt: 'Portugues',
  ar: 'العربية',
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#0b0c10" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicons/apple-touch-icon.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Axsetra Banki" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage || `${siteUrl}/images/logo.webp`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || `${siteUrl}/images/logo.webp`} />

    <!-- Hreflang -->
    {locales.map((loc) => {
      const path = currentPath.replace(`/${lang}/`, `/${loc}/`);
      return <link rel="alternate" hreflang={loc} href={`${siteUrl}${path}`} />;
    })}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en/`} />

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2701690512336282"
      crossorigin="anonymous"
    ></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300..700&display=swap" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" rel="stylesheet" />

    <style is:global>
      *,*::before,*::after{box-sizing:border-box;}
      body{
        background:#050607;
        margin:0;
        font-family:'Comfortaa',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
        display:flex;flex-direction:column;min-height:100vh;
        color:#fff;
      }
      a{color:inherit;text-decoration:none;}
      .container{width:100%;padding-right:15px;padding-left:15px;margin-right:auto;margin-left:auto;max-width:1140px;}
      .flex-fill{flex:1 0 auto;}

      /* --- Header / Navbar --- */
      .app-header{
        background:radial-gradient(900px 220px at 10% 0%,rgba(220,38,38,.14) 0%,rgba(0,0,0,0) 60%),linear-gradient(180deg,#060709 0%,#0b0d10 100%);
        box-shadow:0 10px 30px rgba(0,0,0,.45);
        border-top:1px solid #dc3545;
        border-bottom:1px solid #dc3545;
      }

      /* --- Hero --- */
      .hero-wk{
        min-height:72vh;
        background-image:url('/images/hero2.webp');
        background-size:cover;background-position:center;background-repeat:no-repeat;
        position:relative;display:flex;align-items:center;
      }
      .hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.80) 0%,rgba(0,0,0,.55) 55%,rgba(0,0,0,.28) 100%);}
      .hero-panel{display:inline-block;padding:18px;border-radius:16px;background:rgba(0,0,0,.18);backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);border:1px solid rgba(255,255,255,.08);font-family:"Abel",sans-serif;}
      .hero-text{text-shadow:0 2px 10px rgba(0,0,0,.55),0 6px 30px rgba(0,0,0,.45),0 0 2px rgba(0,0,0,.85);}
      .hero-lead{color:rgba(255,255,255,.92)!important;}

      /* --- Buttons --- */
      .btn{display:inline-block;font-weight:400;text-align:center;cursor:pointer;border:1px solid transparent;padding:.5rem 1rem;font-size:1rem;line-height:1.5;border-radius:.25rem;text-decoration:none;transition:filter .2s;}
      .btn-danger{background:linear-gradient(180deg,#ff3b3b 0%,#d11212 100%);border-color:#d11212;color:#fff;}
      .btn-danger:hover{filter:brightness(1.05);}
      .btn-outline-light{color:#f8f9fa;border-color:#f8f9fa;background:transparent;}
      .btn-outline-light:hover{background:rgba(255,255,255,.1);}
      .btn-light{background:#f8f9fa;color:#212529;border-color:#f8f9fa;}
      .btn-light:hover{background:#e2e6ea;}
      .btn-primary{background:#0d6efd;border-color:#0d6efd;color:#fff;}
      .btn-primary:hover{background:#0b5ed7;}
      .btn-success{background:#198754;border-color:#198754;color:#fff;}
      .btn-success:hover{background:#157347;}
      .btn-lg{padding:.5rem 1rem;font-size:1.25rem;line-height:1.5;border-radius:.3rem;}
      .btn-sm{padding:.25rem .5rem;font-size:.875rem;border-radius:.2rem;}

      /* --- Glass cards --- */
      .wk-card{
        background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
        border-radius:18px;padding:28px 26px;
        border:1px solid rgba(255,255,255,.08);
        backdrop-filter:blur(2px);
        display:flex;flex-direction:column;
      }

      /* --- Footer --- */
      .footer-ax{
        background:radial-gradient(1200px 500px at 20% 0%,rgba(255,255,255,.08),transparent 55%),linear-gradient(180deg,#060709 0%,#07162a 100%);
        border-top:1px solid rgba(255,255,255,.10);color:#fff;
      }

      /* --- Grid (Bootstrap-like) --- */
      .row{display:flex;flex-wrap:wrap;margin-right:-15px;margin-left:-15px;}
      .col-lg-4,.col-lg-5,.col-lg-6,.col-lg-7,.col-lg-8,.col-lg-9,.col-12{position:relative;width:100%;padding-right:15px;padding-left:15px;}
      .col-sm-6{position:relative;width:100%;padding-right:15px;padding-left:15px;}
      @media(min-width:576px){.col-sm-6{flex:0 0 50%;max-width:50%;}}
      @media(min-width:992px){
        .col-lg-4{flex:0 0 33.333333%;max-width:33.333333%;}
        .col-lg-5{flex:0 0 41.666667%;max-width:41.666667%;}
        .col-lg-6{flex:0 0 50%;max-width:50%;}
        .col-lg-7{flex:0 0 58.333333%;max-width:58.333333%;}
        .col-lg-8{flex:0 0 66.666667%;max-width:66.666667%;}
        .col-lg-9{flex:0 0 75%;max-width:75%;}
      }
      .col-md-6{position:relative;width:100%;padding-right:15px;padding-left:15px;}
      @media(min-width:768px){.col-md-6{flex:0 0 50%;max-width:50%;}}

      .g-4{--bs-gutter-x:1.5rem;--bs-gutter-y:1.5rem;margin-top:calc(-1*var(--bs-gutter-y));margin-right:calc(-.5*var(--bs-gutter-x));margin-left:calc(-.5*var(--bs-gutter-x));}
      .g-4>*{padding-right:calc(var(--bs-gutter-x)*.5);padding-left:calc(var(--bs-gutter-x)*.5);margin-top:var(--bs-gutter-y);}
      .g-3{--bs-gutter-x:1rem;--bs-gutter-y:1rem;margin-top:calc(-1*var(--bs-gutter-y));margin-right:calc(-.5*var(--bs-gutter-x));margin-left:calc(-.5*var(--bs-gutter-x));}
      .g-3>*{padding-right:calc(var(--bs-gutter-x)*.5);padding-left:calc(var(--bs-gutter-x)*.5);margin-top:var(--bs-gutter-y);}

      /* --- Utility classes --- */
      .text-white{color:#fff!important;}.text-white-50{color:rgba(255,255,255,.5)!important;}
      .text-primary{color:#0d6efd!important;}.text-success{color:#198754!important;}.text-danger{color:#dc3545!important;}.text-warning{color:#ffc107!important;}
      .fw-semibold{font-weight:600!important;}.fw-bolder{font-weight:700!important;}
      .fs-1{font-size:2.5rem!important;}.fs-5{font-size:1.25rem!important;}.fs-6{font-size:1rem!important;}
      .mb-0{margin-bottom:0!important;}.mb-1{margin-bottom:.25rem!important;}.mb-2{margin-bottom:.5rem!important;}.mb-3{margin-bottom:1rem!important;}.mb-4{margin-bottom:1.5rem!important;}
      .mt-auto{margin-top:auto!important;}.mt-2{margin-top:.5rem!important;}.mt-3{margin-top:1rem!important;}.mt-4{margin-top:1.5rem!important;}
      .me-2{margin-right:.5rem!important;}.me-3{margin-right:1rem!important;}
      .ms-1{margin-left:.25rem!important;}.ms-3{margin-left:1rem!important;}
      .py-2{padding-top:.5rem!important;padding-bottom:.5rem!important;}
      .py-3{padding-top:1rem!important;padding-bottom:1rem!important;}.py-5{padding-top:3rem!important;padding-bottom:3rem!important;}
      .px-3{padding-left:1rem!important;padding-right:1rem!important;}.px-4{padding-left:1.5rem!important;padding-right:1.5rem!important;}
      .p-3{padding:1rem!important;}.p-4{padding:1.5rem!important;}
      .pt-3{padding-top:1rem!important;}
      .d-flex{display:flex!important;}.d-grid{display:grid!important;}.d-inline-flex{display:inline-flex!important;}.d-inline-block{display:inline-block!important;}
      .flex-column{flex-direction:column!important;}.flex-wrap{flex-wrap:wrap!important;}.flex-nowrap{flex-wrap:nowrap!important;}
      .align-items-center{align-items:center!important;}.align-items-start{align-items:flex-start!important;}.align-items-stretch{align-items:stretch!important;}
      .justify-content-center{justify-content:center!important;}.justify-content-between{justify-content:space-between!important;}.justify-content-end{justify-content:flex-end!important;}
      .gap-2{gap:.5rem!important;}.gap-3{gap:1rem!important;}
      .h-100{height:100%!important;}.w-100{width:100%!important;}
      .text-center{text-align:center!important;}.text-start{text-align:left!important;}
      .text-decoration-none{text-decoration:none!important;}
      .rounded-3{border-radius:.5rem!important;}.rounded-4{border-radius:.75rem!important;}
      .overflow-hidden{overflow:hidden!important;}
      .position-relative{position:relative!important;}
      .small{font-size:.875em!important;}
      .img-fluid{max-width:100%;height:auto;}
      .list-unstyled{padding-left:0;list-style:none;}
      .lead{font-size:1.25rem;font-weight:300;}
      .border{border:1px solid rgba(255,255,255,.2)!important;}
      .border-primary{border-color:#0d6efd!important;}
      .border-success{border-color:#198754!important;}
      .border-danger{border-color:#dc3545!important;}
      .border-warning{border-color:#ffc107!important;}
      .border-3{border-width:3px!important;}
      .rounded-circle{border-radius:50%!important;}
      .bg-black{background-color:#000!important;}

      @media(min-width:768px){
        .flex-md-row{flex-direction:row!important;}
        .mt-md-0{margin-top:0!important;}
        .ms-md-auto{margin-left:auto!important;}
        .text-md-end{text-align:right!important;}
        .w-md-auto{width:auto!important;}
      }

      /* --- Ad slots --- */
      .ad-slot{
        background:rgba(255,255,255,.03);
        border:1px solid rgba(255,255,255,.08);
        padding:20px;text-align:center;
        margin:0;min-height:90px;
        display:flex;align-items:center;justify-content:center;
        color:rgba(255,255,255,.3);font-size:.8rem;
      }

      /* --- Language switcher in nav --- */
      .lang-nav{display:flex;gap:6px;flex-wrap:wrap;}
      .lang-nav a{
        color:rgba(255,255,255,.6);padding:4px 10px;border-radius:4px;font-size:.8rem;
        transition:color .2s,background .2s;
      }
      .lang-nav a:hover,.lang-nav a.active{
        color:#fff;background:rgba(255,255,255,.1);
      }
    </style>
  </head>
  <body class="d-flex flex-column" style="min-height:100vh;">
    <slot />

    <script>
      document.getElementById('footer-year')!.textContent = String(new Date().getFullYear());

      // Copy email
      (function(){
        const e="info@axsetra.com",b=document.getElementById("copyEmail");
        if(!b)return;
        b.addEventListener("click",async()=>{
          try{await navigator.clipboard.writeText(e);b.textContent="Copied!";setTimeout(()=>b.textContent="Copy",1200);}
          catch(x){const t=document.createElement("input");t.value=e;document.body.appendChild(t);t.select();document.execCommand("copy");document.body.removeChild(t);b.textContent="Copied!";setTimeout(()=>b.textContent="Copy",1200);}
        });
      })();

      // Card rotator
      (function(){
        const r=document.getElementById('cardRotator');if(!r)return;
        const s=Array.from(r.querySelectorAll('.card-slide'));if(s.length<=1)return;let i=0;
        function show(n: number){s.forEach((x: any, k: number)=>{if(k===n){x.style.opacity='1';x.style.transform='translateY(0)';x.style.pointerEvents='auto';}else{x.style.opacity='0';x.style.transform='translateY(6px)';x.style.pointerEvents='none';}});}
        setInterval(()=>{i=(i+1)%s.length;show(i);},10000);
      })();

      // Fetch rates
      async function fetchRates(){
        try{
          const s=['BTCUSDT','ETHUSDT','BNBUSDT','SOLUSDT','USDCUSDT','EURUSDT'];
          const q=encodeURIComponent(JSON.stringify(s));
          const r=await fetch('https://api.binance.com/api/v3/ticker/price?symbols='+q);
          if(!r.ok)return;const d=await r.json();const m:Record<string,number>={};
          d.forEach((x:any)=>{m[x.symbol]=parseFloat(x.price);});
          function f(v:number|undefined,dp:number){return v!=null?v.toLocaleString('en-US',{minimumFractionDigits:dp,maximumFractionDigits:dp}):'--';}
          const el=(id:string)=>document.getElementById(id);
          if(el('rate-EURUSDT'))el('rate-EURUSDT')!.textContent=f(m['EURUSDT'],4);
          if(el('rate-USDCUSDT'))el('rate-USDCUSDT')!.textContent=f(m['USDCUSDT'],4);
          if(el('rate-BTCUSDT'))el('rate-BTCUSDT')!.textContent=f(m['BTCUSDT'],2);
          if(el('rate-ETHUSDT'))el('rate-ETHUSDT')!.textContent=f(m['ETHUSDT'],2);
          if(el('rate-BNBUSDT'))el('rate-BNBUSDT')!.textContent=f(m['BNBUSDT'],2);
          if(el('rate-SOLUSDT'))el('rate-SOLUSDT')!.textContent=f(m['SOLUSDT'],2);
          const u=document.getElementById('rates-updated');
          if(u)u.textContent=new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
        }catch(e){console.warn('Rates fetch failed:',e);}
      }
      fetchRates();setInterval(fetchRates,60000);
    </script>
  </body>
</html>
