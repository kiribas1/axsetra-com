  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-lg-8 text-center">
        <h2 class="text-white mb-3">البطاقات وأسعار السوق</h2>
        <p class="text-white-50 mb-0">شبكات البطاقات + أحدث الأسعار المرجعية.</p>
      </div>
