---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'ar';
const currentPath = Astro.url.pathname;
const locales = ['en', 'es', 'zh', 'ru', 'pt', 'ar'];
const langNames: Record<string, string> = {
  en: 'English', es: 'Espanol', zh: '中文', ru: 'Русский', pt: 'Portugues', ar: 'العربية',
};
---

<BaseLayout
  title="Axsetra Banki | خدمات مالية رقمية وحسابات ومدفوعات دولية"
  description="يقدم Axsetra Banki خدمات مالية رقمية حديثة للأفراد والشركات: بنية تحتية للحسابات والبطاقات وحلول الدفع الدولية المصممة لعالم رقمي عالمي."
  lang={lang}
  ogImage="https://axsetra.com/images/logo.webp"
>

<!-- NAVBAR -->
<header class="app-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-center py-3">
      <a href={`/${lang}/`} class="d-flex align-items-center text-decoration-none">
        <img src="/images/logo.webp" alt="Axsetra Banki" height="110" class="me-2" />
      </a>
      <div class="mt-3 mt-md-0 ms-md-auto text-center text-md-end w-100 w-md-auto d-flex flex-column flex-md-row align-items-center gap-3">
        <nav class="lang-nav">
          {locales.map((loc) => {
            const path = currentPath.replace(`/${lang}/`, `/${loc}/`);
            return <a href={path} class={loc === lang ? 'active' : ''}>{langNames[loc]}</a>;
          })}
        </nav>
        <div>
          <a href="/ar/login" class="me-3 fw-semibold" style="color:#dc3545;">تسجيل الدخول</a>
          <a href="/ar/open-account" class="btn btn-danger py-2 px-3">افتح حساباً عبر الإنترنت</a>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="flex-fill">

<!-- HERO -->
<section class="hero-wk">
  <div class="hero-overlay"></div>
  <div class="container position-relative py-5">
    <div class="row">
      <div class="col-lg-8">
        <div class="hero-panel hero-text">
          <p class="lead hero-lead mb-3 fs-1 fw-bolder"><strong>حيث تلتقي الخصوصية بالأداء</strong> في الخدمات المصرفية الرقمية الحديثة.</p>
          <p class="lead hero-lead mb-4 fs-5 fw-bolder">نُمكّن الأفراد والشركات من إدارة المدفوعات والحسابات والأصول الرقمية من خلال منصة مالية آمنة تركز على الخصوصية وعالية الأداء — مصممة لعالم رقمي عالمي.</p>
          <p class="lead hero-lead mb-4 fs-6 fw-bolder">100% عبر الإنترنت. بدون فروع. افتح حساباً بنكياً مجانياً بكل راحة من المنزل.</p>
          <div class="d-flex flex-wrap gap-2">
            <a href="/ar/open-account" class="btn btn-light btn-lg px-4">افتح حساباً</a>
            <a href="/ar/login" class="btn btn-outline-light btn-lg px-4">تسجيل الدخول</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
</div>

<!-- ACCOUNT SOLUTIONS -->
<section class="py-5" style="background:#0b0c10;color:#fff;">
  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-lg-9">
        <h2 class="text-white mb-2">حلول الحسابات والودائع التنظيمية</h2>
        <p class="text-white-50 mb-0" style="line-height:1.7;">اختر الحساب المناسب لاحتياجاتك. لمتقدمي التراخيص، نقدم أيضاً حسابات ودائع ضمان متوافقة مع KIFA — منفصلة عن الحسابات التشغيلية.</p>
      </div>
    </div>
    <div class="row g-4 mb-4">
      <div class="col-lg-6">
        <div class="wk-card h-100 text-primary">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user fa-2xs border border-primary border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> شخصي</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">خدمات مالية شخصية مصممة للأفراد والعائلات الذين يقدرون الخصوصية والمرونة والتحكم الرقمي الكامل.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">حسابات شخصية وعائلية</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">بطاقات خصم وافتراضية</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">خدمات متوافقة مع العملات المشفرة</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">بطاقات مجهولة لتعزيز الخصوصية</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">كشوف حساب عبر الإنترنت فقط</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">بدون مكالمات هاتفية — التواصل عبر البريد الإلكتروني المفضل</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>حلول الحسابات متاحة لغير المقيمين</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/ar/open-account" class="btn btn-primary btn-sm px-4">افتح حساباً</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="wk-card h-100 text-success">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user-tie fa-2xs border border-success border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> تجاري</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">بنية تحتية مالية لرواد الأعمال والشركات العاملة عبر الحدود، مع أدوات حديثة وعمليات مبسطة.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">حسابات تجارية للشركات والمهنيين</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">بطاقات للمالكين وأعضاء الفريق</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">مدفوعات العملات المشفرة وإدارة الأصول</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">بطاقات الموظفين مع ضوابط الإنفاق</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">كشوف حساب وتقارير رقمية بالكامل</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">سياسة التواصل عبر البريد الإلكتروني فقط</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>حسابات تجارية متاحة للمؤسسين والشركات غير المقيمة</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/ar/open-account" class="btn btn-success btn-sm px-4">افتح حساباً</a>
          </div>
        </div>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="wk-card h-100 text-danger">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user-group fa-2xs border border-danger border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> مؤسسي</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">حلول مالية متقدمة للهياكل المؤسسية التي تتطلب قابلية التوسع والسرية والوصول الدولي.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">حسابات مؤسسية ومتعددة الكيانات</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">بطاقات للمديرين التنفيذيين والموظفين</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">حلول دفع بالعملات المشفرة وغير مصرفية</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">خيارات بطاقات عالية الخصوصية</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">كشوف حساب ووثائق رقمية فقط</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">بدون زيارات للفروع، بدون مكالمات غير مرغوب فيها</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>حلول مؤسسية متاحة للمنظمات غير المقيمة</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/ar/open-account" class="btn btn-danger btn-sm px-4">افتح حساباً</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="wk-card h-100 text-warning" style="border-color:rgba(255,193,7,0.3);">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-shield-halved fa-2xs border border-warning border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> وديعة ضمان KIFA</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">حساب مخصص لرأس مال ضمان الترخيص، متوافق مع متطلبات <a href="https://kiribas.org" target="_blank" style="color:inherit;">هيئة كيريباتي المالية الدولية (KIFA)</a>.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>تظل الأموال ملكاً للمساهمين</strong> — محتفظ بها بموجب شروط مقيدة</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">رأس مال قابل للتحقق علنياً كدليل على الامتثال التنظيمي</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">منفصل عن الحسابات التشغيلية</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">يشمل وصول إشرافي من KIFA</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">فترة القفل محددة بشروط الترخيص</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>تختلف المتطلبات حسب نوع الترخيص</strong> — يحددها KIFA بناءً على:</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; النشاط التجاري وفئة الترخيص</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; حجم العمليات المتوقع</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; قدرة العملاء وملف المخاطر</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
