---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'ru';
const currentPath = Astro.url.pathname;
const locales = ['en', 'es', 'zh', 'ru', 'pt', 'ar'];
const langNames: Record<string, string> = {
  en: 'English', es: 'Espanol', zh: '中文', ru: 'Русский', pt: 'Portugues', ar: 'العربية',
};
---

<BaseLayout
  title="Axsetra Banki | Цифровые финансовые услуги, счета и международные платежи"
  description="Axsetra Banki предоставляет современные цифровые финансовые услуги для физических и юридических лиц: инфраструктура счетов, карты и решения для международных платежей."
  lang={lang}
  ogImage="https://axsetra.com/images/logo.webp"
>

<!-- NAVBAR -->
<header class="app-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-center py-3">
      <a href={`/${lang}/`} class="d-flex align-items-center text-decoration-none">
        <img src="/images/logo.webp" alt="Axsetra Banki" height="110" class="me-2" />
      </a>
      <div class="mt-3 mt-md-0 ms-md-auto text-center text-md-end w-100 w-md-auto d-flex flex-column flex-md-row align-items-center gap-3">
        <nav class="lang-nav">
          {locales.map((loc) => {
            const path = currentPath.replace(`/${lang}/`, `/${loc}/`);
            return <a href={path} class={loc === lang ? 'active' : ''}>{langNames[loc]}</a>;
          })}
        </nav>
        <div>
          <a href="/login" class="me-3 fw-semibold" style="color:#dc3545;">Войти</a>
          <a href="/open-account" class="btn btn-danger py-2 px-3">Открыть счёт онлайн</a>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="flex-fill">

<!-- HERO -->
<section class="hero-wk">
  <div class="hero-overlay"></div>
  <div class="container position-relative py-5">
    <div class="row">
      <div class="col-lg-8">
        <div class="hero-panel hero-text">
          <p class="lead hero-lead mb-3 fs-1 fw-bolder"><strong>Где приватность встречается с производительностью</strong> в современном цифровом банкинге.</p>
          <p class="lead hero-lead mb-4 fs-5 fw-bolder">Мы помогаем физическим и юридическим лицам управлять платежами, счетами и цифровыми активами через безопасную, ориентированную на конфиденциальность и высокопроизводительную финансовую платформу — созданную для глобального цифрового мира.</p>
          <p class="lead hero-lead mb-4 fs-6 fw-bolder">100% онлайн. Без отделений. Откройте бесплатный банковский счёт, не выходя из дома.</p>
          <div class="d-flex flex-wrap gap-2">
            <a href="/open-account" class="btn btn-light btn-lg px-4">Открыть счёт</a>
            <a href="/login" class="btn btn-outline-light btn-lg px-4">Войти</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
</div>

<!-- ACCOUNT SOLUTIONS -->
<section class="py-5" style="background:#0b0c10;color:#fff;">
  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-lg-9">
        <h2 class="text-white mb-2">Решения для счетов и регуляторные депозиты</h2>
        <p class="text-white-50 mb-0" style="line-height:1.7;">Выберите подходящий счёт для ваших потребностей. Для заявителей на лицензию мы также предлагаем специальные гарантийные депозитные счета, соответствующие требованиям KIFA — отдельно от операционных счетов.</p>
      </div>
    </div>
    <div class="row g-4 mb-4">
      <div class="col-lg-6">
        <div class="wk-card h-100 text-primary">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user fa-2xs border border-primary border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Личный</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Персональные финансовые услуги для частных лиц и семей, которые ценят конфиденциальность, гибкость и полный цифровой контроль.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Личные и семейные счета</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Дебетовые и виртуальные карты</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Крипто-дружественные сервисы</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Анонимные карты для повышенной конфиденциальности</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Только онлайн выписки по счёту</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Без телефонных звонков — связь через предпочтительную электронную почту</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Решения для счетов доступны нерезидентам</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/open-account" class="btn btn-primary btn-sm px-4">Открыть счёт</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="wk-card h-100 text-success">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user-tie fa-2xs border border-success border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Бизнес</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Финансовая инфраструктура для предпринимателей и компаний, работающих через границы, с современными инструментами и оптимизированными процессами.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Бизнес-счета для компаний и профессионалов</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Карты для владельцев и членов команды</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Криптовалютные платежи и управление активами</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Карты для сотрудников с контролем расходов</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Полностью цифровые выписки и отчётность</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Политика связи только по электронной почте</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Бизнес-счета доступны для нерезидентов-основателей и компаний</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/open-account" class="btn btn-success btn-sm px-4">Открыть счёт</a>
          </div>
        </div>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="wk-card h-100 text-danger">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user-group fa-2xs border border-danger border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Корпоративный</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Продвинутые финансовые решения для корпоративных структур, требующих масштабируемости, конфиденциальности и международного охвата.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Корпоративные и мульти-юридические счета</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Карты для руководителей и сотрудников</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Крипто и небанковские платёжные решения</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Карты с высоким уровнем приватности</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Только цифровые выписки и документация</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Без посещения отделений, без незапрошенных звонков</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Корпоративные решения доступны для нерезидентных организаций</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/open-account" class="btn btn-danger btn-sm px-4">Открыть счёт</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="wk-card h-100 text-warning" style="border-color:rgba(255,193,7,0.3);">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-shield-halved fa-2xs border border-warning border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Гарантийный депозит KIFA</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Специальный счёт для гарантийного лицензионного капитала, соответствующий требованиям <a href="https://kiribas.org" target="_blank" style="color:inherit;">Международного финансового управления Кирибати (KIFA)</a>.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Средства остаются собственностью акционеров</strong> — хранятся на ограниченных условиях</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Публично проверяемый капитал как доказательство соответствия регуляторным требованиям</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Отдельно от операционных счетов</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Включён надзорный доступ KIFA</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Период блокировки определяется условиями лицензии</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Требования зависят от типа лицензии</strong> — определяются KIFA на основании:</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Вид деятельности и категория лицензии</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Прогнозируемый объём операций</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Клиентская ёмкость и профиль рисков</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
