---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Axsetra Banki | Digital Banking with Privacy"
  description="100% online digital bank. No branches. Open a free bank account comfortably from home. Personal, business, and corporate accounts with crypto services."
  lang="en"
>
  <Fragment slot="logo">Axsetra Banki</Fragment>
  <Fragment slot="footer-name">Axsetra Banki</Fragment>

  <section class="hero">
    <img src="/images/logo.webp" alt="Logo" class="hero-logo" width="200" height="auto" />
    <h1>Axsetra Banki</h1>
    <p class="tagline">Where privacy meets performance</p>
    <p>100% online. No branches. Open a free bank account comfortably from home.</p>
  </section>

  <div class="ad-slot">Ad Space - Google AdSense</div>

  <div class="card-grid">
    <article class="card">
      <h2>Personal Accounts</h2>
      <p>Debit and virtual cards, crypto-friendly services, anonymous cards for enhanced privacy. Communication via email only, no phone calls.</p>
    </article>
    <article class="card">
      <h2>Business Accounts</h2>
      <p>For entrepreneurs and companies operating across borders. Employee cards with spending controls and crypto payment capabilities.</p>
    </article>
    <article class="card">
      <h2>Corporate Accounts</h2>
      <p>Advanced financial solutions for corporate structures requiring scalability, discretion and international reach. Multi-entity support and high-privacy card options.</p>
    </article>
    <article class="card">
      <h2>KIFA Guarantee Deposit</h2>
      <p>Specialized account for license capital. Funds remain property of shareholders under restricted conditions, separate from operational accounts.</p>
    </article>
    <article class="card">
      <h2>Crypto Services</h2>
      <p>Multi-network crypto wallets, cold-wallet custody, crypto-to-fiat exchange and staking options.</p>
    </article>
    <article class="card">
      <h2>Card Networks</h2>
      <p>Visa, UnionPay, Maestro. Digital statements exclusively.</p>
    </article>
  </div>

  <div class="ad-slot">Ad Space - Google AdSense</div>

  <section class="registration-info">
    <h2>Registration & Legal</h2>
    <p><strong>Company Registration:</strong> CP-000022</p>
    <p><strong>License (KBN):</strong> KBN-90-000001</p>
    <p><strong>Registered Office:</strong> London (KI)</p>
    <p><strong>Operating Location:</strong> Kiritimati, Kiribati</p>
    <p><strong>Contact:</strong> info@axsetra.com | +686 75127188</p>
  </section>

  <div class="ad-slot">Ad Space - Google AdSense</div>
</BaseLayout>

<style>
  .hero-logo {
    max-width: 200px;
    height: auto;
    margin-bottom: 20px;
    border-radius: 8px;
  }
  .tagline {
    font-size: 1.4rem;
    font-weight: 600;
    opacity: 1;
    margin-bottom: 8px;
  }
  .registration-info {
    background: white;
    border-radius: 8px;
    padding: 32px;
    margin-top: 32px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    text-align: center;
  }
  .registration-info h2 {
    margin-bottom: 16px;
    color: #1a1a2e;
  }
  .registration-info p {
    margin: 6px 0;
    color: #555;
  }
</style>
