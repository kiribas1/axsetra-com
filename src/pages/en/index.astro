    <div class="row g-4 align-items-start">
      <div class="col-12 col-lg-4">
        <div class="d-flex align-items-center gap-2 mb-3">
          <div style="width:14px;height:14px;border-radius:6px;background:rgba(255,255,255,.85);box-shadow:0 0 0 4px rgba(255,255,255,.08);flex:0 0 auto;"></div>
          <div><div class="fw-semibold">Axsetra Banki</div><div class="small text-white-50">&copy; <span id="footer-year"></span> &#8226; All rights reserved</div></div>
        </div>
        <ul class="list-unstyled small mb-0 text-white-50">
          <li><a href="https://kiribas.net/company/company/1/" style="color:rgba(255,255,255,.70);text-decoration:none;" target="_blank">Company Registration</a> CP-000022</li>
          <li><a href="https://kiribas.org/licensed-entities/?q=axsetra" target="_blank" style="color:rgba(255,255,255,.70);text-decoration:none;">Licence KBN:</a> KBN-90-000001</li>
          <li><span style="color:rgba(255,255,255,.75);">Registered Office (non-op.):</span> London (KI)</li>
          <li><span style="color:rgba(255,255,255,.75);">Location:</span> Kiritimati, Kiribati</li>
          <li class="mt-3 d-flex align-items-center gap-2">
            <a style="color:rgba(255,255,255,.70);text-decoration:none;" href="mailto:info@axsetra.com">info@axsetra.com</a>
            <button id="copyEmail" type="button" class="btn btn-sm btn-outline-light ms-1" style="border-color:rgba(255,255,255,.25);color:rgba(255,255,255,.85);">Copy</button>
          </li>
          <li class="mt-2"><a style="color:rgba(255,255,255,.70);text-decoration:none;" href="tel:+68675127188">+686 75127188</a></li>
        </ul>
      </div>
      <div class="col-12 col-lg-4">
        <div style="font-weight:600;color:rgba(255,255,255,.92);margin-bottom:1rem;">Products & Policies</div>
        <ul class="list-unstyled mb-0">
          <li style="padding:.28rem 0;"><a href="#" style="color:rgba(255,255,255,.70);text-decoration:none;">Personal Account</a></li>
          <li style="padding:.28rem 0;"><a href="#" style="color:rgba(255,255,255,.70);text-decoration:none;">Business Account</a></li>
          <li style="padding:.28rem 0;margin-bottom:1rem;"><a href="#" style="color:rgba(255,255,255,.70);text-decoration:none;">Corporate Account</a></li>
          <li style="padding:.28rem 0;"><a href="#" style="color:rgba(255,255,255,.70);text-decoration:none;">General Terms</a></li>
          <li style="padding:.28rem 0;"><a href="#" style="color:rgba(255,255,255,.70);text-decoration:none;">Privacy Policy</a></li>
        </ul>
      </div>
      <div class="col-12 col-lg-4">
        <div style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:16px;">
          <div style="font-weight:600;color:rgba(255,255,255,.92);margin-bottom:.5rem;">Continuity Notice</div>
          <p class="small mb-0 text-white-50">Axsetra.com is the official continuation of the Axsetra Banki originally operated under the domain <strong style="color:rgba(255,255,255,.75);">axsetra.ki</strong>, active since 2011.<br /><br />The transition to the current domain does not affect the continuity of the bank, its identity, or its historical presence.</p>
        </div>
      </div>
    </div>
    <hr style="border-color:rgba(255,255,255,.12);opacity:1;margin:1.5rem 0;" />
    <div class="d-flex flex-column flex-md-row gap-2 justify-content-between small text-white-50">
      <div class="d-flex align-items-center gap-2">
        <span style="width:8px;height:8px;border-radius:999px;background:rgba(255,255,255,.35);display:inline-block;"></span>
        <span>Secure communications recommended for sensitive data.</span>
      </div>
    </div>
  </div>
</footer>

</BaseLayout>
