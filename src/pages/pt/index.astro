---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'pt';
const currentPath = Astro.url.pathname;
const locales = ['en', 'es', 'zh', 'ru', 'pt', 'ar'];
const langNames: Record<string, string> = {
  en: 'English', es: 'Espanol', zh: '中文', ru: 'Русский', pt: 'Portugues', ar: 'العربية',
};
---

<BaseLayout
  title="Axsetra Banki | Servicos Financeiros Digitais, Contas e Pagamentos Internacionais"
  description="Axsetra Banki oferece servicos financeiros digitais modernos para individuos e empresas: infraestrutura de contas, cartoes e solucoes de pagamento internacional para um mundo global e digital."
  lang={lang}
  ogImage="https://axsetra.com/images/logo.webp"
>

<!-- NAVBAR -->
<header class="app-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-center py-3">
      <a href={`/${lang}/`} class="d-flex align-items-center text-decoration-none">
        <img src="/images/logo.webp" alt="Axsetra Banki" height="110" class="me-2" />
      </a>
      <div class="mt-3 mt-md-0 ms-md-auto text-center text-md-end w-100 w-md-auto d-flex flex-column flex-md-row align-items-center gap-3">
        <nav class="lang-nav">
          {locales.map((loc) => {
            const path = currentPath.replace(`/${lang}/`, `/${loc}/`);
            return <a href={path} class={loc === lang ? 'active' : ''}>{langNames[loc]}</a>;
          })}
        </nav>
        <div>
          <a href="/pt/login" class="me-3 fw-semibold" style="color:#dc3545;">Entrar</a>
          <a href="/pt/open-account" class="btn btn-danger py-2 px-3">Abrir Conta Online</a>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="flex-fill">

<!-- HERO -->
<section class="hero-wk">
  <div class="hero-overlay"></div>
  <div class="container position-relative py-5">
    <div class="row">
      <div class="col-lg-8">
        <div class="hero-panel hero-text">
          <p class="lead hero-lead mb-3 fs-1 fw-bolder"><strong>Onde a privacidade encontra o desempenho</strong> na banca digital moderna.</p>
          <p class="lead hero-lead mb-4 fs-5 fw-bolder">Capacitamos individuos e empresas a gerir pagamentos, contas e ativos digitais atraves de uma plataforma financeira segura, focada na privacidade e de alto desempenho — construida para um mundo global e digital.</p>
          <p class="lead hero-lead mb-4 fs-6 fw-bolder">100% online. Sem agencias. Abra uma conta bancaria gratuita confortavelmente de casa.</p>
          <div class="d-flex flex-wrap gap-2">
            <a href="/pt/open-account" class="btn btn-light btn-lg px-4">Abrir Conta</a>
            <a href="/pt/login" class="btn btn-outline-light btn-lg px-4">Entrar</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
</div>

<!-- ACCOUNT SOLUTIONS -->
<section class="py-5" style="background:#0b0c10;color:#fff;">
  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-lg-9">
        <h2 class="text-white mb-2">Solucoes de contas e depositos regulatorios</h2>
        <p class="text-white-50 mb-0" style="line-height:1.7;">Escolha a conta certa para as suas necessidades. Para candidatos a licencas, tambem oferecemos contas de deposito de garantia compativeis com KIFA — separadas das contas operacionais.</p>
      </div>
    </div>
    <div class="row g-4 mb-4">
      <div class="col-lg-6">
        <div class="wk-card h-100 text-primary">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user fa-2xs border border-primary border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Pessoal</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Servicos financeiros pessoais concebidos para individuos e familias que valorizam privacidade, flexibilidade e controlo digital completo.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Contas pessoais e familiares</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Cartoes de debito e virtuais</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Servicos compativeis com criptomoedas</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Cartoes anonimos para maior privacidade</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Extratos de conta apenas online</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Sem chamadas telefonicas — comunicacao por e-mail preferido</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Solucoes de contas disponiveis para nao residentes</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/pt/open-account" class="btn btn-primary btn-sm px-4">Abrir Conta</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="wk-card h-100 text-success">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user-tie fa-2xs border border-success border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Empresarial</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Infraestrutura financeira para empreendedores e empresas que operam alem-fronteiras, com ferramentas modernas e processos simplificados.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Contas empresariais para empresas e profissionais</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Cartoes para proprietarios e membros da equipa</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Pagamentos com criptomoedas e gestao de ativos</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Cartoes para funcionarios com controlos de despesas</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Extratos e relatorios totalmente digitais</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Politica de comunicacao apenas por e-mail</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Contas empresariais disponiveis para fundadores e empresas nao residentes</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/pt/open-account" class="btn btn-success btn-sm px-4">Abrir Conta</a>
          </div>
        </div>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="wk-card h-100 text-danger">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user-group fa-2xs border border-danger border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Corporativo</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Solucoes financeiras avancadas para estruturas corporativas que exigem escalabilidade, discricao e alcance internacional.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Contas corporativas e multi-entidade</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Cartoes para executivos e funcionarios</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Solucoes de pagamento cripto e nao bancarias</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Opcoes de cartoes de alta privacidade</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Extratos e documentacao apenas digitais</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Sem visitas a agencias, sem chamadas nao solicitadas</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Solucoes corporativas acessiveis a organizacoes nao residentes</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/pt/open-account" class="btn btn-danger btn-sm px-4">Abrir Conta</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="wk-card h-100 text-warning" style="border-color:rgba(255,193,7,0.3);">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-shield-halved fa-2xs border border-warning border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Deposito de Garantia KIFA</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Conta dedicada para capital de garantia de licenca, em conformidade com os requisitos da <a href="https://kiribas.org" target="_blank" style="color:inherit;">Autoridade Financeira Internacional de Kiribati (KIFA)</a>.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Os fundos permanecem propriedade dos acionistas</strong> — mantidos sob condicoes restritas</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Capital publicamente verificavel como prova de conformidade regulatoria</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Separado das contas operacionais</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Acesso de supervisao KIFA incluido</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Periodo de bloqueio definido pelos termos da licenca</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Os requisitos variam conforme o tipo de licenca</strong> — determinados pela KIFA com base em:</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Atividade comercial e categoria de licenca</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Volume operacional projetado</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Capacidade do cliente e perfil de risco</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
