---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'zh';
const currentPath = Astro.url.pathname;
const locales = ['en', 'es', 'zh', 'ru', 'pt', 'ar'];
const langNames: Record<string, string> = {
  en: 'English', es: 'Espanol', zh: '中文', ru: 'Русский', pt: 'Portugues', ar: 'العربية',
};
---

<BaseLayout
  title="Axsetra Banki | 数字金融服务、账户与国际支付"
  description="Axsetra Banki 为个人和企业提供现代数字金融服务：账户基础设施、银行卡和国际支付解决方案，专为全球化、数字优先的世界打造。"
  lang={lang}
  ogImage="https://axsetra.com/images/logo.webp"
>

<!-- NAVBAR -->
<header class="app-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-center py-3">
      <a href={`/${lang}/`} class="d-flex align-items-center text-decoration-none">
        <img src="/images/logo.webp" alt="Axsetra Banki" height="110" class="me-2" />
      </a>
      <div class="mt-3 mt-md-0 ms-md-auto text-center text-md-end w-100 w-md-auto d-flex flex-column flex-md-row align-items-center gap-3">
        <nav class="lang-nav">
          {locales.map((loc) => {
            const path = currentPath.replace(`/${lang}/`, `/${loc}/`);
            return <a href={path} class={loc === lang ? 'active' : ''}>{langNames[loc]}</a>;
          })}
        </nav>
        <div>
          <a href="/login" class="me-3 fw-semibold" style="color:#dc3545;">登录</a>
          <a href="/open-account" class="btn btn-danger py-2 px-3">在线开户</a>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="flex-fill">

<!-- HERO -->
<section class="hero-wk">
  <div class="hero-overlay"></div>
  <div class="container position-relative py-5">
    <div class="row">
      <div class="col-lg-8">
        <div class="hero-panel hero-text">
          <p class="lead hero-lead mb-3 fs-1 fw-bolder"><strong>隐私与性能的完美结合</strong>，现代数字银行。</p>
          <p class="lead hero-lead mb-4 fs-5 fw-bolder">我们赋能个人和企业，通过安全、注重隐私的高性能金融平台管理支付、账户和数字资产——专为全球化、数字优先的世界打造。</p>
          <p class="lead hero-lead mb-4 fs-6 fw-bolder">100%在线。无实体网点。在家即可轻松开设免费银行账户。</p>
          <div class="d-flex flex-wrap gap-2">
            <a href="/open-account" class="btn btn-light btn-lg px-4">开设账户</a>
            <a href="/login" class="btn btn-outline-light btn-lg px-4">登录</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
</div>

