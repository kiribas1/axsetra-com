---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'es';
---

<BaseLayout
  title="Iniciar sesión – Axsetra Banki"
  description="Inicio de sesión seguro para titulares de cuentas de Axsetra Banki."
  lang={lang}
  robots="noindex,nofollow"
>

<header class="app-header">
  <div class="container">
    <div class="d-flex flex-column align-items-center py-3">
      <a href={`/${lang}/`} class="d-flex align-items-center text-decoration-none">
        <img src="/images/logo.webp" alt="Axsetra Banki" height="90" />
      </a>
    </div>
  </div>
</header>

<main class="flex-fill auth-wrap">
  <div class="container">
    <div class="auth-row">
      <div class="auth-card">
        <div class="auth-topline"></div>
        <div class="auth-card-body">

          <div class="auth-top-row">
            <span class="auth-badge">
              <span class="shield">&#128737;</span>
              Acceso Seguro de Cliente
            </span>
            <div>
              <a href={`/${lang}/open-account`} class="btn btn-danger">Abrir Cuenta</a>
            </div>
          </div>

          <h1 class="auth-title">Inicio de Sesión de Cliente</h1>
          <p class="auth-subtitle">Acceda a su cuenta mediante autenticación protegida. Cuando esté habilitado, se le pedirá completar verificación adicional (por ejemplo, códigos de un solo uso) para confirmar su identidad.</p>

          <div class="auth-divider"></div>

          <div class="auth-grid">
            <div class="auth-form-col">

              <div id="error-box" class="error-box">
                Usuario o contraseña incorrectos.
              </div>

              <form id="loginForm" novalidate>
                <div class="form-group">
                  <label for="id_login">Correo o usuario del cliente</label>
                  <input id="id_login" name="login" type="text" class="input-dark" placeholder="nombre@empresa.com" autocomplete="username" required />
                </div>
                <div class="form-group">
                  <label for="id_password">Contraseña</label>
                  <div class="pw-wrap">
                    <input id="id_password" name="password" type="password" class="input-dark pw-input" placeholder="Ingrese su contraseña" autocomplete="current-password" required />
                    <button type="button" class="pw-toggle" id="pwToggle" aria-pressed="false">&#128065;</button>
                  </div>
                </div>
                <div class="form-row-between">
                  <div class="remember-wrap">
                    <input type="checkbox" value="on" id="id_remember" name="remember" />
                    <label for="id_remember">Recordar este dispositivo</label>
                  </div>
                  <a class="link-muted" href="#">¿Olvidó su contraseña?</a>
                </div>
                <div class="btn-stack">
                  <button type="submit" class="btn btn-danger btn-lg">
                    Iniciar sesión
                  </button>
                  <a href={`/${lang}/`} class="btn btn-outline-light">
                    Volver al inicio
                  </a>
                </div>
                <p class="fineprint">
                  Para su protección, podemos requerir verificación adicional según las señales de riesgo y la configuración de la cuenta.
                </p>
              </form>
            </div>

            <div class="auth-side-col">
              <div class="security-panel">
                <div class="label">Aviso de seguridad</div>
                <ul>
                  <li>Verifique siempre el dominio antes de introducir sus credenciales.</li>
                  <li>Nunca comparta contraseñas o códigos de un solo uso.</li>
                  <li>Podemos solicitar un segundo factor para acciones sensibles.</li>
                  <li>Si sospecha de acceso no autorizado, contacte a soporte de inmediato.</li>
                </ul>
              </div>
              <div class="security-panel security-panel-spaced">
                <div class="label">¿Necesita acceso?</div>
                <ul>
                  <li>Los registros pueden estar limitados durante mejoras de capacidad.</li>
                  <li>Únase a la lista de prioridad en la página de registro.</li>
                  <li>Incorporación empresarial disponible bajo solicitud.</li>
                </ul>
              </div>
              <div class="contact-support-wrap">
                <a class="btn btn-outline-light contact-support-btn" href="mailto:support@axsetra.com">
                  Contactar soporte
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</main>

</BaseLayout>

<style>
  .auth-wrap{min-height:calc(100vh - 120px);display:flex;align-items:center;padding:56px 0;background:radial-gradient(1100px 650px at 15% 8%,rgba(255,255,255,.06),transparent 60%),radial-gradient(900px 500px at 82% 20%,rgba(220,53,69,.14),transparent 55%),linear-gradient(180deg,#070a0f 0%,#05060a 100%);}
  .auth-row{display:flex;justify-content:center;}
  .auth-card{border:1px solid rgba(255,255,255,.08);background:rgba(8,10,14,.90);backdrop-filter:blur(10px);border-radius:18px;box-shadow:0 22px 70px rgba(0,0,0,.60);overflow:hidden;width:100%;max-width:700px;}
  .auth-topline{height:2px;background:linear-gradient(90deg,rgba(220,53,69,0),rgba(220,53,69,.75),rgba(220,53,69,0));}
  .auth-card-body{padding:2rem 2.5rem;}
  .auth-top-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:1.5rem;}
  .auth-badge{display:inline-flex;align-items:center;gap:10px;padding:8px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.10);background:rgba(255,255,255,.04);font-size:.92rem;color:rgba(255,255,255,.86);}
  .shield{width:26px;height:26px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;background:rgba(220,53,69,.14);border:1px solid rgba(220,53,69,.22);color:rgba(255,255,255,.92);font-size:.95rem;line-height:1;}
  .auth-title{color:#fff;letter-spacing:-0.02em;font-size:calc(1.375rem + 1.5vw);font-weight:300;margin-bottom:.5rem;}
  .auth-subtitle{color:rgba(255,255,255,.75);font-size:1.02rem;line-height:1.65;margin:0;}
  .auth-divider{height:1px;background:rgba(255,255,255,.08);margin:18px 0 22px;}
  .fineprint{color:rgba(255,255,255,.55);font-size:.92rem;line-height:1.45;margin-top:1rem;margin-bottom:0;}
  .input-dark{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff;width:100%;padding:.5rem 1rem;font-size:1.1rem;border-radius:.3rem;}
  .input-dark:focus{outline:none;box-shadow:0 0 0 .20rem rgba(220,53,69,.18);border-color:rgba(220,53,69,.40);}
  .input-dark::placeholder{color:rgba(255,255,255,.45);}
  .link-muted{color:rgba(255,255,255,.70);text-decoration:none;}
  .link-muted:hover{color:rgba(255,255,255,.92);text-decoration:underline;}
  .security-panel{border:1px solid rgba(255,255,255,.10);background:rgba(255,255,255,.03);border-radius:14px;padding:12px 14px;}
  .security-panel-spaced{margin-top:1rem;}
  .security-panel .label{color:rgba(255,255,255,.85);font-weight:600;font-size:.95rem;margin-bottom:6px;}
  .security-panel ul{margin:0;padding-left:18px;color:rgba(255,255,255,.70);font-size:.93rem;line-height:1.5;}
  .security-panel li{margin:4px 0;}
  .pw-wrap{position:relative;}
  .pw-toggle{position:absolute;right:12px;top:50%;transform:translateY(-50%);border:0;background:transparent;padding:6px;line-height:1;color:rgba(255,255,255,.75);cursor:pointer;}
  .pw-input{padding-right:3.2rem;}
  .form-group{margin-bottom:1rem;}
  .form-group label{display:block;margin-bottom:.5rem;color:rgba(255,255,255,.5);font-size:.875rem;}
  .form-row-between{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:.5rem;}
  .remember-wrap{display:flex;align-items:center;gap:.5rem;}
  .remember-wrap label{color:rgba(255,255,255,.5);font-size:.875rem;cursor:pointer;margin:0;}
  .btn-stack{display:grid;gap:.5rem;}
  .btn-stack .btn{width:100%;}
  .error-box{display:none;background:rgba(220,53,69,.15);border:1px solid rgba(220,53,69,.4);border-radius:.375rem;padding:.75rem 1rem;color:#f8d7da;margin-bottom:1rem;font-size:.95rem;}
  .auth-grid{display:flex;flex-wrap:wrap;gap:1.5rem;}
  .auth-form-col{flex:1 1 280px;}
  .auth-side-col{flex:0 1 220px;}
  .contact-support-wrap{margin-top:1rem;}
  .contact-support-btn{display:block;width:100%;}
</style>

<script>
  const pwToggle = document.getElementById('pwToggle');
  pwToggle?.addEventListener('click', function () {
    const inp = document.getElementById('id_password') as HTMLInputElement;
    const pressed = pwToggle.getAttribute('aria-pressed') === 'true';
    inp.type = pressed ? 'password' : 'text';
    pwToggle.setAttribute('aria-pressed', String(!pressed));
    pwToggle.textContent = pressed ? '\u{1F441}' : '\u{1F648}';
  });

  const loginForm = document.getElementById('loginForm');
  loginForm?.addEventListener('submit', function (e) {
    e.preventDefault();
    const login = (document.getElementById('id_login') as HTMLInputElement).value.trim();
    const password = (document.getElementById('id_password') as HTMLInputElement).value;
    const box = document.getElementById('error-box') as HTMLElement;

    if (!login || !password) {
      box.textContent = 'Por favor complete todos los campos.';
      box.style.display = 'block';
      return;
    }

    const btn = (loginForm as HTMLFormElement).querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Iniciando sesión…';

    setTimeout(function () {
      box.textContent = 'Usuario o contraseña incorrectos.';
      box.style.display = 'block';
      (document.getElementById('id_password') as HTMLInputElement).value = '';
      btn.disabled = false;
      btn.textContent = 'Iniciar sesión';
    }, 900);
  });
</script>
