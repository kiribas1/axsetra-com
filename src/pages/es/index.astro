---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'es';
const currentPath = Astro.url.pathname;
const locales = ['en', 'es', 'zh', 'ru', 'pt', 'ar'];
const langNames: Record<string, string> = {
  en: 'English', es: 'Espanol', zh: '中文', ru: 'Русский', pt: 'Portugues', ar: 'العربية',
};
---

<BaseLayout
  title="Axsetra Banki | Servicios Financieros Digitales, Cuentas y Pagos Internacionales"
  description="Axsetra Banki ofrece servicios financieros digitales modernos para individuos y empresas: infraestructura de cuentas, tarjetas y soluciones de pago internacional para un mundo global y digital."
  lang={lang}
  ogImage="https://axsetra.com/images/logo.webp"
>

<!-- NAVBAR -->
<header class="app-header">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-center py-3">
      <a href={`/${lang}/`} class="d-flex align-items-center text-decoration-none">
        <img src="/images/logo.webp" alt="Axsetra Banki" height="110" class="me-2" />
      </a>
      <div class="mt-3 mt-md-0 ms-md-auto text-center text-md-end w-100 w-md-auto d-flex flex-column flex-md-row align-items-center gap-3">
        <nav class="lang-nav">
          {locales.map((loc) => {
            const path = currentPath.replace(`/${lang}/`, `/${loc}/`);
            return <a href={path} class={loc === lang ? 'active' : ''}>{langNames[loc]}</a>;
          })}
        </nav>
        <div>
          <a href="/es/login" class="me-3 fw-semibold" style="color:#dc3545;">Iniciar Sesion</a>
          <a href="/es/open-account" class="btn btn-danger py-2 px-3">Abrir Cuenta Online</a>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="flex-fill">

<!-- HERO -->
<section class="hero-wk">
  <div class="hero-overlay"></div>
  <div class="container position-relative py-5">
    <div class="row">
      <div class="col-lg-8">
        <div class="hero-panel hero-text">
          <p class="lead hero-lead mb-3 fs-1 fw-bolder"><strong>Donde la privacidad se encuentra con el rendimiento</strong> en la banca digital moderna.</p>
          <p class="lead hero-lead mb-4 fs-5 fw-bolder">Empoderamos a individuos y empresas para gestionar pagos, cuentas y activos digitales a traves de una plataforma financiera segura, enfocada en la privacidad y de alto rendimiento, creada para un mundo global y digital.</p>
          <p class="lead hero-lead mb-4 fs-6 fw-bolder">100% en linea. Sin sucursales. Abra una cuenta bancaria gratuita comodamente desde casa.</p>
          <div class="d-flex flex-wrap gap-2">
            <a href="/es/open-account" class="btn btn-light btn-lg px-4">Abrir Cuenta</a>
            <a href="/es/login" class="btn btn-outline-light btn-lg px-4">Iniciar Sesion</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
</div>

<!-- ACCOUNT SOLUTIONS -->
<section class="py-5" style="background:#0b0c10;color:#fff;">
  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-lg-9">
        <h2 class="text-white mb-2">Soluciones de cuentas y depositos regulatorios</h2>
        <p class="text-white-50 mb-0" style="line-height:1.7;">Elija la cuenta adecuada para sus necesidades. Para solicitantes de licencias, tambien ofrecemos cuentas de deposito de garantia compatibles con KIFA, separadas de las cuentas operativas.</p>
      </div>
    </div>
    <div class="row g-4 mb-4">
      <div class="col-lg-6">
        <div class="wk-card h-100 text-primary">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user fa-2xs border border-primary border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Personal</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Servicios financieros personales disenados para individuos y familias que valoran la privacidad, la flexibilidad y el control digital completo.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Cuentas personales y familiares</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Tarjetas de debito y virtuales</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Servicios compatibles con criptomonedas</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Tarjetas anonimas para mayor privacidad</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Estados de cuenta solo en linea</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Sin llamadas telefonicas — comunicacion por correo electronico preferido</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Soluciones de cuentas disponibles para no residentes</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/es/open-account" class="btn btn-primary btn-sm px-4">Abrir Cuenta</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="wk-card h-100 text-success">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user-tie fa-2xs border border-success border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Empresarial</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Infraestructura financiera para emprendedores y empresas que operan a traves de fronteras, con herramientas modernas y procesos optimizados.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Cuentas comerciales para empresas y profesionales</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Tarjetas para propietarios y miembros del equipo</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Pagos con criptomonedas y gestion de activos</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Tarjetas para empleados con controles de gasto</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Estados de cuenta y reportes totalmente digitales</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Politica de comunicacion solo por correo electronico</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Cuentas comerciales disponibles para fundadores y empresas no residentes</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/es/open-account" class="btn btn-success btn-sm px-4">Abrir Cuenta</a>
          </div>
        </div>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-lg-6">
        <div class="wk-card h-100 text-danger">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-user-group fa-2xs border border-danger border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Corporativo</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Soluciones financieras avanzadas para estructuras corporativas que requieren escalabilidad, discrecion y alcance internacional.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Cuentas corporativas y multi-entidad</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Tarjetas para ejecutivos y empleados</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Soluciones de pago cripto y no bancarias</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Opciones de tarjetas de alta privacidad</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Estados de cuenta y documentacion solo digital</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Sin visitas a sucursales, sin llamadas no solicitadas</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Soluciones corporativas accesibles para organizaciones no residentes</strong></li>
          </ul>
          <div class="mt-auto pt-3 d-flex justify-content-end flex-nowrap gap-2">
            <a href="/es/open-account" class="btn btn-danger btn-sm px-4">Abrir Cuenta</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="wk-card h-100 text-warning" style="border-color:rgba(255,193,7,0.3);">
          <h3 style="font-weight:600;margin-bottom:14px;"><i class="fa-solid fa-shield-halved fa-2xs border border-warning border-3 rounded-circle d-inline-flex align-items-center justify-content-center bg-black" style="width:40px;height:40px;"></i> Deposito de Garantia KIFA</h3>
          <p style="color:rgba(255,255,255,.85);margin-bottom:16px;">Cuenta dedicada para capital de garantia de licencia, compatible con los requisitos de la <a href="https://kiribas.org" target="_blank" style="color:inherit;">Autoridad Financiera Internacional de Kiribati (KIFA)</a>.</p>
          <ul style="padding-left:18px;margin:0;">
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Los fondos siguen siendo propiedad de los accionistas</strong> — mantenidos bajo condiciones restringidas</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Capital verificable publicamente como prueba de cumplimiento regulatorio</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Separado de las cuentas operativas</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Acceso de supervision KIFA incluido</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;">Periodo de bloqueo definido por los terminos de la licencia</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;"><strong>Los requisitos varian segun el tipo de licencia</strong> — determinados por KIFA segun:</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Actividad comercial y categoria de licencia</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Volumen operativo proyectado</li>
            <li style="color:rgba(255,255,255,.80);margin-bottom:8px;margin-left:1rem;">&#8226; Capacidad del cliente y perfil de riesgo</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- AD SLOT -->
<div class="ad-slot">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-2701690512336282" data-ad-slot="auto" data-ad-format="auto" data-full-width-responsive="true"></ins>
